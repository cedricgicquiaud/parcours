{
  "name": "parcours",
  "version": "0.1.0",
  "description": "Plateforme personnelle de formation : un lecteur de formations en markdown",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n server,ui \"npm run dev:server\" \"npm run dev:ui\"",
    "dev:server": "tsx watch server/main.ts",
    "dev:ui": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "better-sqlite3": "^13.0.1",
    "hono": "^4.12.32",
    "markdown-it": "^15.0.0",
    "mermaid": "^11.16.1",
    "nodemailer": "^9.0.5",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "@fontsource/open-sans": "^5.3.0",
    "@phosphor-icons/web": "^2.1.2",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.2",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "better-sqlite3@13.0.1": true,
    "esbuild@0.28.2": true
  }
}
